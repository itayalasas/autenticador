{
  "expo": {
    "name": "AuthSystem",
    "slug": "authsystem-mobile-authenticator",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.authsystem.authenticator",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Esta app usa notificaciones para aprobar inicios de sesión MFA."
      }
    },
    "android": {
      "package": "com.authsystem.authenticator",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "245ac28f-c50c-45f0-855b-a575fcd795c5"
      }
    },
    "owner": "pedro.ayala"
  }
}
