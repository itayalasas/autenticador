# Supabase Configuration (Frontend - con prefijo VITE_)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key

# Supabase Configuration (Backend - sin prefijo VITE_)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# JWT Configuration
JWT_SECRET=tu_jwt_secret_super_seguro_cambialo_en_produccion

# Server Configuration (only for local development)
PORT=3001

# DLocal Configuration
# API URL - URL base de la API de dLocal (sandbox: api-sbx.dlocalgo.com, producción: api.dlocalgo.com)
VITE_DLOCAL_API_URL=https://api-sbx.dlocalgo.com
# Checkout URL - URL base del checkout de dLocal (sandbox: checkout-sbx.dlocalgo.com, producción: checkout.dlocalgo.com)
VITE_DLOCAL_CHECKOUT_URL=https://checkout-sbx.dlocalgo.com
# API Key - Clave pública de dLocal
VITE_DLOCAL_API_KEY=tu_dlocal_api_key
# Secret Key - Clave secreta de dLocal
VITE_DLOCAL_SECRET_KEY=tu_dlocal_secret_key
# Plans Endpoint - Endpoint para obtener los planes de suscripción
VITE_DLOCAL_PLANS_ENDPOINT=v1/subscription/plan/all
# Merchant ID - ID de tu cuenta de comerciante en dLocal
VITE_DLOCAL_MERCHANT_ID=tu_merchant_id
